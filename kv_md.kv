#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp
#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import MDApp kivymd.app.MDApp
#:import scaled ui_scale.scaled
#:import AuroraBackground ui_fx.AuroraBackground
#:import FancyMDButton client_widgets.FancyMDButton
#:import MDLinearProgressIndicator kivymd.uix.progressindicator.MDLinearProgressIndicator

# Button heights are written literally as dp(N) so they read at their
# nominal size. They used to be scaled by 2/3, which drew a 40dp button
# as 26.67dp and the smallest as 21px -- below the 48dp touch target.
# The shared factor lives in ui_scale.py (currently 1.0) so the KV layout
# and the Python-built popups stay in sync.
#
# This class rule only covers MDButtons that do NOT set a height of their
# own -- a widget's own property always wins over a class rule, so every
# explicit height below carries the factor too.
<MDButton>:
    height: scaled(dp(40))

<PFPEditorWidget>:
    canvas.after:
        Color:
            rgba: 0, 0, 0, 0.4
        Ellipse:
            pos: root.crop_cx - root.crop_r, root.crop_cy - root.crop_r
            size: root.crop_r * 2, root.crop_r * 2
        Color:
            rgba: app.theme_colors['text']
        Line:
            circle: root.crop_cx, root.crop_cy, root.crop_r
            width: 2
    PassThroughImage:
        id: pfp_img
        source: root.source
        allow_stretch: False
        keep_ratio: True
        size_hint: None, None
        on_texture_size: root._size_image()

<MessageRow>:
    orientation: 'horizontal'
    size_hint_y: None
    height: self.minimum_height
    padding: [dp(12), dp(5) if root.grouped else dp(10)]
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: app.theme_colors['msg_own'] if root.is_own else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8), dp(8), dp(8), dp(8)]
        Color:
            rgba: app.theme_colors['primary'] if root.is_own else app.theme_colors['border_subtle']
        RoundedRectangle:
            pos: self.x, self.y + dp(6)
            size: dp(2), self.height - dp(12)
            radius: [dp(1), dp(1), dp(1), dp(1)]

    PfpImage:
        id: pfp
        size_hint: None, None
        size: dp(32), 0 if root.grouped else dp(32)
        opacity: 0 if root.grouped else 1
        source: root.avatar_source or ""
        fallback_letter: root.username[:1]
        allow_stretch: False
        keep_ratio: True

    BoxLayout:
        orientation: 'vertical'
        size_hint_x: 1
        size_hint_y: None
        height: self.minimum_height
        spacing: dp(2)
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 0 if root.grouped else dp(18)
            opacity: 0 if root.grouped else 1
            ClickableLabel:
                text: root.username
                target_hash: root.author_hash
                # Warm white carries the conversation; amber identifies
                # your own posts without tinting every line of body text.
                color: app.theme_colors['primary'] if root.is_own else app.theme_colors['text']
                bold: True
                font_size: sp(13)
                text_size: self.width, None
                size_hint_x: 1
                halign: 'left'
                valign: 'middle'
                shorten: True
                on_press: app.open_profile(root.author_hash, root.username)
            Label:
                text: root.ts
                color: app.theme_colors['text_dim']
                font_size: sp(11)
                text_size: self.width, None
                size_hint_x: None
                width: dp(50)
                halign: 'right'
                valign: 'middle'

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(44) if root.reply_author else 0
            opacity: 1 if root.reply_author else 0
            padding: [dp(10), dp(4)]
            canvas.before:
                Color:
                    rgba: app.theme_colors['border_subtle']
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(10), dp(10), dp(10), dp(10)]
            Label:
                text: '> @' + root.reply_author
                color: app.theme_colors['accent']
                bold: True
                font_size: sp(11)
                text_size: self.width, None
                halign: 'left'
            Label:
                text: root.reply_excerpt
                color: app.theme_colors['text_muted']
                font_size: sp(11)
                shorten: True
                text_size: self.width, None
                halign: 'left'

        # Embed container - holds image embeds for this message.
        # Placed directly under the username header so embeds are top-left,
        # next to the sender, and the row expands to contain them so the
        # following message lands beneath (not overlapping).
        BoxLayout:
            id: embed_container
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(6)

        Label:
            id: content_lbl
            text: root.content_markup
            markup: True
            color: app.theme_colors['text']
            font_size: sp(14)
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1]
            halign: 'left'
            valign: 'top'

    Widget:
        size_hint_x: None
        width: dp(4)

<ChannelButton>:
    orientation: 'vertical'
    size_hint_y: None
    height: dp(48)
    padding: [dp(14), 0]
    spacing: dp(4)
    canvas.before:
        Color:
            rgba: app.theme_colors['sidebar_ctrl'] if root.selected else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(7), dp(7), dp(7), dp(7)]
        Color:
            rgba: app.theme_colors['primary'] if root.selected else (0, 0, 0, 0)
        Rectangle:
            pos: self.x, self.y + dp(8)
            size: dp(3), self.height - dp(16)
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: 1
        Label:
            text: '#   ' + root.channel_name
            color: app.theme_colors['text'] if root.selected else app.theme_colors['text_muted']
            bold: root.selected
            font_size: sp(14)
            halign: 'left'
            valign: 'middle'
            text_size: self.width, self.height
            size_hint_x: 1
        Label:
            id: badge
            text: str(root.badge) if root.badge else ''
            color: app.theme_colors['text']
            bold: True
            font_size: sp(12)
            size_hint_x: None
            width: dp(40) if root.badge else 0
            halign: 'right'
            valign: 'middle'
            text_size: self.width, self.height

<MessageEmbed>:
    size_hint_y: None
    height: dp(200)
    size_hint_x: None
    width: dp(400)
    allow_stretch: False
    keep_ratio: True
    canvas.before:
        Color:
            rgba: app.theme_colors['msg_own']
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12), dp(12), dp(12), dp(12)]

<FullScreenImageOverlay>:
    size_hint: 1, 1
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.85
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        size_hint: 1, 1
        padding: dp(40)
        AsyncImage:
            id: full_image
            source: root.source
            allow_stretch: False
            keep_ratio: True
            size_hint: 1, 1
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
        FancyMDButton:
            variant: 'primary'
            size_hint_y: None
            height: scaled(dp(40))
            size_hint_x: None
            width: dp(150)
            pos_hint: {'center_x': 0.5}
            on_press: root.download_image()
            MDButtonText:
                text: 'Download'
        FancyMDButton:
            variant: 'outlined'
            size_hint_y: None
            height: scaled(dp(40))
            size_hint_x: None
            width: dp(150)
            pos_hint: {'center_x': 0.5}
            on_press: root.dismiss()
            MDButtonText:
                text: 'Close'

<MemberRow>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(36)
    padding: [dp(8), 0]
    spacing: dp(8)
    PfpImage:
        id: pfpx
        size_hint: None, None
        size: dp(26), dp(26)
        source: root.avatar_source or ""
        fallback_letter: root.username[:1]
        allow_stretch: False
        keep_ratio: True
    ClickableLabel:
        text: root.username
        target_hash: root.author_hash
        color: app.theme_colors['text_muted']
        font_size: sp(13)
        halign: 'left'
        valign: 'middle'
        text_size: self.width, None
        # Task 2: a long name wrapped to 2-3 lines and painted outside
        # its 36px row. Single-line with ellipsis, like the message
        # author label.
        shorten: True
        size_hint_x: 1
        on_press: app.open_profile(root.author_hash, root.username)
    Widget:
        size_hint_x: None
        width: dp(12)
    CanvasWidget:
        id: presence_dot
        size_hint: None, None
        size: dp(10), dp(10)
        color: root.presence_color

<ProfileScreen>:
    ScrollView:
        do_scroll_x: False
        bar_width: dp(6)
        canvas.before:
            Color:
                rgba: app.theme_colors['bg_main']
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            padding: dp(20)
            spacing: dp(15)
            Label:
                text: 'Profile'
                font_size: sp(32)
                bold: True
                color: app.theme_colors['text']
                size_hint_y: None
                height: dp(50)
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(200)
                spacing: dp(10)
                Widget:
                    size_hint_x: 1
                PfpImage:
                    id: profile_pfp
                    size_hint: None, None
                    size: dp(150), dp(150)
                    source: root.target_avatar or ''
                    fallback_letter: root.target_username[:1]
                    allow_stretch: False
                    keep_ratio: True
                    canvas.after:
                        Color:
                            rgba: 0, 0, 0, 0.5
                        Ellipse:
                            pos: self.center_x - dp(75), self.center_y - dp(75)
                            size: dp(150), dp(150)
                        Color:
                            rgba: app.theme_colors['text']
                        Line:
                            circle: self.center_x, self.center_y, 75
                            width: 2
                Widget:
                    size_hint_x: 1
            Label:
                text: root.target_username
                font_size: sp(20)
                bold: True
                color: app.theme_colors['text']
                size_hint_y: None
                height: dp(30)
                halign: 'center'
                text_size: self.width, None
            MDTextField:
                id: profile_username_input
                text: root.target_username
                mode: 'filled'
                size_hint_y: None
                height: dp(56)
                fill_color_normal: app.theme_colors['input_bg']
                fill_color_focus: app.theme_colors['input_bg_focus']
                text_color_normal: app.theme_colors['text']
                text_color_focus: app.theme_colors['text']
                cursor_color: app.theme_colors['text']
                MDTextFieldHintText:
                    text: 'Username'
                    text_color_normal: app.theme_colors['text']
                    text_color_focus: app.theme_colors['text']
            Label:
                id: profile_status
                text: ''
                font_size: sp(11)
                color: app.theme_colors['text_muted']
                size_hint_y: None
                height: dp(18)
            Label:
                text: 'Node hash: ' + root.target_hash
                font_size: sp(11)
                color: app.theme_colors['text_muted']
                size_hint_y: None
                height: dp(20)
                halign: 'center'
                text_size: self.width, None
                shorten: True
            # The lxmf.delivery hash -- previously this line rendered
            # target_username, so the profile showed the name twice and the
            # label claimed to be a hash that it was not.
            Label:
                text: 'Delivery: ' + root.target_delivery
                font_size: sp(11)
                color: app.theme_colors['text_muted']
                size_hint_y: None
                height: dp(20)
                halign: 'center'
                text_size: self.width, None
                shorten: True
            Label:
                id: profile_card_alias
                text: ''
                font_size: sp(14)
                bold: True
                color: app.theme_colors['text']
                size_hint_y: None
                height: dp(24)
                halign: 'center'
                text_size: self.width, None
            # ---- contact card QR (v0.34, tay: collectible profile card) ----
            # the QR carries the public keyset only; tap copy below to hand
            # the payload to someone as text (v1 import path)
            Image:
                id: profile_card_qr
                size_hint: None, None
                size: dp(180), dp(180)
                source: ''
                # Task 2: an Image with no source draws a white rect;
                # hide the whole QR block (image + border) until a card
                # is actually rendered for this profile.
                opacity: 1 if self.source else 0
                allow_stretch: True
                pos_hint: {'center_x': 0.5}
                canvas.after:
                    Color:
                        rgba: app.theme_colors['text']
                    Line:
                        rounded_rectangle: self.x - dp(6), self.y - dp(6), self.width + dp(12), self.height + dp(12), dp(10)
                        width: 1.5
            FancyMDButton:
                variant: 'outlined'
                size_hint_x: None
                width: dp(230)
                pos_hint: {'center_x': 0.5}
                on_press: app.share_contact_card()
                MDButtonText:
                    text: 'Copy card payload'
                    text_color: app.theme_colors['text']
            FancyMDButton:
                variant: 'outlined'
                size_hint_x: None
                width: dp(230)
                pos_hint: {'center_x': 0.5}
                on_press: app.open_config()
                MDButtonText:
                    text: 'Settings'
                    text_color: app.theme_colors['text']
            FancyMDButton:
                variant: 'outlined'
                size_hint_x: None
                width: dp(230)
                pos_hint: {'center_x': 0.5}
                on_press: app.import_contact_card()
                MDButtonText:
                    text: 'Import card from clipboard'
                    text_color: app.theme_colors['text']
            FancyMDButton:
                variant: 'outlined'
                size_hint_x: None
                width: dp(230)
                pos_hint: {'center_x': 0.5}
                on_press: app.open_recovery_sheet()
                MDButtonText:
                    text: 'Save recovery kit'
                    text_color: app.theme_colors['text']
            FancyMDButton:
                variant: 'outlined'
                size_hint_x: None
                width: dp(230)
                pos_hint: {'center_x': 0.5}
                on_press: app.open_command_palette()
                MDButtonText:
                    text: 'Slash commands'
                    text_color: app.theme_colors['text']
            BoxLayout:
                size_hint_y: None
                height: dp(50)
                spacing: dp(10)
                FancyMDButton:
                    variant: 'primary'
                    size_hint_x: None
                    width: dp(140)
                    on_press: app.open_file_chooser(avatar=True)
                    MDButtonText:
                        text: 'Change Avatar'
                        text_color: app.theme_colors['btn_text']
                FancyMDButton:
                    variant: 'primary'
                    size_hint_x: None
                    width: dp(140)
                    on_press: app.save_profile()
                    MDButtonText:
                        text: 'Save Username'
                        text_color: app.theme_colors['btn_text']
                FancyMDButton:
                    variant: 'outlined'
                    size_hint_x: None
                    width: dp(100)
                    on_press: app.root.current = 'main'
                    MDButtonText:
                        text: 'Back'
                        text_color: app.theme_colors['text']
            FancyMDButton:
                id: profile_delete
                # P1 (plan_admin v1.1, tay 2026-11-19): purge this
                # guild account from the server; two-stage type-to-
                # confirm carries the literals the server validates.
                variant: 'danger'
                size_hint_x: None
                width: dp(230)
                pos_hint: {'center_x': 0.5}
                on_press: app.open_confirm_delete_account()
                MDButtonText:
                    text: 'Delete account'
                    text_color: 1, 1, 1, 1

<MainScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: app.theme_colors['bg_main']
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(56)
            padding: [dp(10), dp(6)]
            spacing: dp(6)
            canvas.before:
                Color:
                    rgba: app.theme_colors['topbar']
                Rectangle:
                    pos: self.pos
                    size: self.size
                # 1px hairline so the header reads as a header and not as
                # chrome floating over the chat (topbar == bg_main).
                Color:
                    rgba: app.theme_colors['border_subtle']
                Rectangle:
                    pos: self.x, self.y
                    size: self.width, dp(1)
            HamburgerIcon:
                on_press: root.toggle_left()
                color: app.theme_colors['primary'] if root.left_open else app.theme_colors['text_muted']
            MeshPulse:
                mode: app.mesh_mode
                width: dp(40)
            MeshConstellation:
                mode: app.mesh_mode
                hops: app.mesh_hops
                width: dp(46)
            Label:
                text: app.mesh_label
                color: app.theme_colors['accent'] if app.mesh_mode == 'direct' else app.theme_colors['primary'] if app.mesh_mode == 'relay' else app.theme_colors['text_dim']
                bold: True
                font_size: sp(9)
                size_hint_x: None
                width: dp(65)
                shorten: True
            CtxHeaderLabel:
                id: channel_header
                text: '#' + (root._current_channel or 'general')
                color: app.theme_colors['text']
                bold: True
                font_size: sp(18)
                size_hint_x: 1
                halign: 'left'
                valign: 'middle'
                text_size: self.width, None
                shorten: True
            MDButton:
                style: 'text'
                size_hint_x: None
                width: dp(82)
                on_press: root.toggle_right()
                MDButtonText:
                    text: 'People'
                    text_color: app.theme_colors['primary'] if root.right_open else app.theme_colors['text_muted']
            SearchIcon:
                on_press: app.open_search()
                color: app.theme_colors['text']
            GearIcon:
                on_press: app.open_profile(app.my_hash or '', app.username or '')
                color: app.theme_colors['text']
        BoxLayout:
            # sitenav (g): persistent site nav chrome -- lives outside
            # the page content so Back/Forward and the breadcrumb are
            # reachable without scrolling to the top of the page. Shown
            # only while a site page is on screen; hidden it collapses
            # to 0px. The in-page < Back link keeps working as well.
            id: site_nav_bar
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(40) if app.site_nav_visible else 0
            opacity: 1 if app.site_nav_visible else 0
            disabled: not app.site_nav_visible
            padding: [dp(8), 0]
            spacing: dp(6)
            canvas.before:
                Color:
                    rgba: app.theme_colors['topbar']
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: app.theme_colors['border_subtle']
                Rectangle:
                    pos: self.x, self.y
                    size: self.width, dp(1)
            MDButton:
                id: site_nav_back
                style: 'text'
                size_hint_x: None
                width: dp(64)
                disabled: not app.site_nav_can_back
                on_press: app.site_go_back()
                MDButtonText:
                    text: '< Back'
                    text_color: app.theme_colors['primary'] if app.site_nav_can_back else app.theme_colors['text_dim']
            MDButton:
                id: site_nav_forward
                style: 'text'
                size_hint_x: None
                width: dp(80)
                disabled: not app.site_nav_can_forward
                on_press: app.site_go_forward()
                MDButtonText:
                    text: 'Forward >'
                    text_color: app.theme_colors['primary'] if app.site_nav_can_forward else app.theme_colors['text_dim']
            Label:
                id: site_nav_path
                text: app.site_nav_path
                color: app.theme_colors['text_dim']
                font_size: sp(13)
                halign: 'left'
                valign: 'middle'
                text_size: self.width, None
                shorten: True
        FloatLayout:
            id: chat_body
            size_hint_y: 1
            # v0.32 (tay device note): the drawers become overlay
            # windows that slide OVER the chat screen; they are
            # added after the chat body, so an open drawer paints
            # over the composer instead of squeezing it.


            # ---------------- center: chat ----------------
            BoxLayout:
                id: chat_screen
                orientation: 'vertical'
                size_hint: (1, 1)
                pos_hint: {'x': 0, 'y': 0}
                canvas.before:
                    Color:
                        rgba: app.theme_colors['panel']
                    Rectangle:
                        pos: self.pos
                        size: self.size
                ScrollView:
                    id: scroll
                    do_scroll_x: False
                    bar_width: dp(6)
                    size_hint_y: 1
                    GridLayout:
                        id: message_grid
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(2)
                        padding: [dp(8), dp(8)]
                BoxLayout:
                    id: reply_bar
                    # 32px: pinned by tests/test_reply_cards.py
                    # ("height: dp(32) if app.reply_draft else 0").
                    # Known 4px overhang: the cancel MDButton is 40px
                    # tall (minimum touch target) and sticks 4px out
                    # of this 32px bar top and bottom. The bar height
                    # is a pinned contract, so the overflow test
                    # explicitly tolerates this one pair instead of
                    # growing the bar (see test_uix_layout_overflow).
                    size_hint_y: None
                    height: dp(32) if app.reply_draft else 0
                    opacity: 1 if app.reply_draft else 0
                    padding: [dp(16), dp(2)]
                    Label:
                        text: app.reply_draft
                        color: app.theme_colors['accent']
                        shorten: True
                        text_size: self.width, None
                        halign: 'left'
                        font_size: sp(11)
                    MDButton:
                        style: 'text'
                        size_hint_x: None
                        width: dp(38)
                        on_press: app.cancel_reply()
                        MDButtonText:
                            # G6 (UIX P1-1): ASCII 'x', not the
                            # multiplication sign -- button labels must
                            # stay ASCII (Roboto has no symbol glyphs;
                            # the glyph test pins this).
                            text: 'x'
                BoxLayout:
                    # polish (g): composer upload-progress strip --
                    # a thin bar directly above the composer, visible
                    # only while an upload is in flight. Progress is
                    # state, not motion: the fill jumps to
                    # app.upload_pct (never start() -- the indicator's
                    # own determinate animation would drive the value
                    # itself). Fill = theme primary on a panel_darker
                    # track; both re-tint live with the theme.
                    id: upload_progress_bar
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(4) if app.upload_active else 0
                    opacity: 1 if app.upload_active else 0
                    disabled: not app.upload_active
                    MDLinearProgressIndicator:
                        id: upload_progress_fill
                        type: 'determinate'
                        value: app.upload_pct
                        indicator_color: app.theme_colors['primary']
                        track_color: app.theme_colors['panel_darker']
                        size_hint_y: None
                        height: dp(4)
                BoxLayout:
                    # 56px (task 9): the bar contains the pfp (dp(42)) and
                    # the field. At 48px a dp(42) pfp plus padding
                    # overflowed upward into the message list.
                    # G1 (fixes.md #10): the bar grows with the field --
                    # max(dp(56), field + vertical padding) -- so a
                    # multi-line field expands visibly and the message
                    # list above shrinks instead of the field overflowing.
                    id: composer_bar
                    size_hint_y: None
                    height: max(dp(56), msg_input.height + dp(12))
                    padding: [dp(4), dp(6)]
                    spacing: dp(4)
                    canvas.before:
                        Color:
                            rgba: app.theme_colors['panel_darker']
                        Rectangle:
                            pos: self.pos
                            size: self.size
                    Button:
                        id: composer_pfp_holder
                        background_normal: ''
                        background_down: ''
                        background_color: [0, 0, 0, 0]
                        size_hint_x: None
                        # G6 (UIX P2-1): 48px wide like every other touch
                        # target; was dp(46), 2px under the 48px minimum.
                        width: dp(48)
                        # v0.36.9 (tay): tap opens the profile editor
                        on_press: app.open_profile(app.my_hash or '', app.username or '')
                        PfpImage:
                            id: composer_pfp
                            source: app.composer_pfp_path or ''
                            fallback_letter: (app.username or '')[:1]
                            size: dp(42), dp(42)
                            center: self.parent.center if self.parent else (0, 0)
                            allow_stretch: True
                            keep_ratio: True
                    Widget:
                        # task 9 (tay): the flat attach '+' reads as a
                        # delimited extension of the field, not a second
                        # button: body = input_bg, left corners rounded.
                        # Height matches the field (v0.32 tay device note:
                        # 'attach plate overlaps the pfp at 44px next to
                        # a 40px field'); the glyph is pinned to the plate
                        # because an unbound Label defaults to a 100x100
                        # box and its '+' floats past the plate edge.
                        size_hint: None, None
                        width: dp(38)
                        height: dp(40)
                        canvas.before:
                            Color:
                                rgba: app.theme_colors['input_bg']
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(6), 0, 0, dp(6)]
                        on_touch_down:
                            app.open_attach_dialog() if self.collide_point(*args[1].pos) else None
                        Label:
                            text: '+'
                            color: app.theme_colors['text']
                            font_size: sp(18)
                            pos: self.parent.pos
                            size: self.parent.size
                    MDTextField:
                        id: msg_input
                        disabled: app.composer_readonly
                        mode: 'filled'
                        multiline: True
                        size_hint_x: 1
                        size_hint_y: None
                        # G1 (fixes.md #10): the field grows with its text
                        # up to ~4+ lines instead of capping at one line.
                        # max(dp(40), minimum_height): bare minimum_height
                        # is 37.5px for one line, which would shrink the
                        # single-line field below the 40px the layout test
                        # pins. max_height caps it at dp(160); the composer
                        # bar grows with it (see composer_bar above).
                        height: max(dp(40), self.minimum_height)
                        min_height: dp(40)
                        max_height: dp(160)
                        # G5 (UIX P2-4): border tokens (see hub_address).
                        theme_line_color: 'Custom'
                        line_color_normal: app.theme_colors['border_subtle']
                        line_color_focus: app.theme_colors['border']
                        radius: [0, dp(6), dp(6), 0]
                        fill_color_normal: app.theme_colors['input_bg']
                        fill_color_focus: app.theme_colors['input_bg_focus']
                        text_color_normal: app.theme_colors['text']
                        text_color_focus: app.theme_colors['text']
                        cursor_color: app.theme_colors['text']
                        # v0.31.10: the helper line carries the attach
                        # progress; persistent keeps it visible unfocused
                        helper_text_mode: 'persistent'
                        helper_text: ''
                        helper_text_color: app.theme_colors['text_dim']
                        on_text_validate: app.send_message()
                        MDTextFieldHintText:
                            text: 'announcements only' if app.composer_readonly else 'Message...'
                            text_color_normal: app.theme_colors['text']
                            text_color_focus: app.theme_colors['text']
                    FancyMDButton:
                        variant: 'primary'
                        size_hint_x: None
                        width: dp(56)
                        size_hint_y: None
                        height: scaled(dp(40))
                        disabled: app.composer_readonly
                        on_press: app.send_message()
                        MDButtonText:
                            text: app.composer_send_label
                            text_color: app.theme_colors['btn_text']

            # -------- left: servers + channels in ONE swipe drawer --------
            # The server rail lives INSIDE the drawer so closing the drawer
            # hides the '+' button too (receipt: the rail held the pane
            # open). Open width 284 = 64 rail + 220 channels.
            BoxLayout:
                id: left_sidebar
                size_hint: None, 1
                # Polish group 3: the width is MainScreen.left_width,
                # animated 0 <-> open width by _slide_drawer (the
                # boolean only gates touches and mutual exclusion).
                width: root.left_width
                orientation: 'horizontal'
                pos_hint: {'x': 0}
                canvas.before:
                    Color:
                        rgba: app.theme_colors['bg_sidebar']
                    Rectangle:
                        pos: self.pos
                        size: self.size

                StencilView:
                    id: left_clip
                    size_hint: 1, 1
                    BoxLayout:
                        id: left_pane
                        # v0.36.9 (tay): StencilView clips paint, not touches --
                        # a closed 0-width drawer still let add server swallow
                        # composer taps; disabled propagates and gates them
                        disabled: not root.left_open
                        orientation: 'horizontal'
                        pos: self.parent.pos
                        size: self.parent.size
                        # ---- server rail (guild list) ----
                        BoxLayout:
                            id: server_sidebar
                            size_hint_x: None
                            # 0.36.25 (tay): the rail kept its 64dp box when the
                            # drawer closed and, disabled+collide, ate every
                            # tap in the left 64dp of the message area - the
                            # site page's [ Edit page ] line lives there
                            width: dp(64) if root.left_open else 0
                            orientation: 'vertical'
                            canvas.before:
                                Color:
                                    rgba: app.theme_colors['bg_sidebar']
                                Rectangle:
                                    pos: self.pos
                                    size: self.size
                            ScrollView:
                                do_scroll_x: False
                                GridLayout:
                                    id: server_grid
                                    cols: 1
                                    size_hint_y: None
                                    height: self.minimum_height
                                    spacing: dp(4)
                                    padding: [dp(4), dp(8)]
                            # Add server button at bottom
                            FancyMDButton:
                                id: add_server_btn
                                variant: 'primary'
                                size_hint_y: None
                                height: scaled(dp(40))
                                on_press: app._open_add_server_popup()
                                MDButtonText:
                                    text: '+'
                                    text_color: app.theme_colors['btn_text']
                                    font_size: sp(24)

                        # ---- channels column ----
                        BoxLayout:
                            orientation: 'vertical'
                            FloatLayout:
                                id: banner_strip
                                size_hint_y: None
                                height: dp(96)
                                Image:
                                    id: banner_channel
                                    source: app.banner_channel_path or ''
                                    size_hint: (None, None)
                                    height: dp(96)
                                    width: min(dp(200), banner_strip.width)
                                    allow_stretch: False
                                    keep_ratio: True
                                    pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                                    opacity: 1 if app.banner_channel_path else 0
                                Label:
                                    id: banner_letter
                                    text: app.banner_letter or 'S'
                                    font_size: sp(48)
                                    bold: True
                                    color: app.theme_colors['sidebar_ctrl']
                                    pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                                    opacity: 0 if app.banner_channel_path else 1
                            # Task 2: the strip text lives on the Button
                            # itself, not in a child Label. A child Label
                            # is never positioned by any layout (its
                            # parent is a Button, not a layout), so it kept
                            # its default pos (0, 0) and its text painted
                            # at the window's bottom-left corner -- a
                            # phantom "Update available: " with no version
                            # whenever the drawer opened. The Button's own
                            # text renders inside its bounds; it is ''
                            # while the strip is hidden so nothing paints.
                            Button:
                                id: motd_strip
                                size_hint_y: None
                                height: scaled(dp(22)) if app.server_motd else 0
                                background_normal: ''
                                background_color: (0, 0, 0, 0)
                                disabled: not app.server_motd
                                on_press: app._open_motd_popup()
                                text: (app.server_motd or '')[:64] if app.server_motd else ''
                                font_size: sp(11)
                                color: app.theme_colors['text_dim']
                                halign: 'left'
                                valign: 'middle'
                                text_size: self.width, None
                                shorten: True
                            Button:
                                id: update_strip
                                size_hint_y: None
                                height: scaled(dp(22)) if app.client_update_version else 0
                                background_normal: ''
                                # Task 2: maroon only while an update is
                                # offered. The Button's BorderImage borders
                                # spill outside a 0-height box, so a
                                # constant maroon painted two phantom bars
                                # across the channel column with no update.
                                background_color: (0.55, 0.13, 0.13, 0.85) if app.client_update_version else (0, 0, 0, 0)
                                disabled: not app.client_update_version
                                on_press: app._open_update_prompt()
                                text: ('Update available: ' + (app.client_update_version or ''))[:64] if app.client_update_version else ''
                                font_size: sp(11)
                                color: app.theme_colors['text']
                                halign: 'left'
                                valign: 'middle'
                                text_size: self.width, None
                                shorten: True
                            BoxLayout:
                                size_hint_y: None
                                height: dp(52)
                                padding: [dp(12), dp(6)]
                                Label:
                                    text: 'CHANNELS'
                                    color: app.theme_colors['text_dim']
                                    bold: True
                                    font_size: sp(11)
                                    halign: 'left'
                                    valign: 'middle'
                                    text_size: self.width, None
                                MDButton:
                                    id: add_channel_btn
                                    style: 'outlined'
                                    size_hint_y: None
                                    height: scaled(dp(40))
                                    width: dp(48)
                                    theme_bg_color: 'Custom'
                                    md_bg_color: app.theme_colors['sidebar_ctrl']
                                    opacity: 1 if app._can_create_channels() else 0
                                    disabled: not app._can_create_channels()
                                    on_press: app._open_create_channel_popup()
                                    MDButtonText:
                                        text: '+'
                                        shorten: True
                            ScrollView:
                                do_scroll_x: False
                                GridLayout:
                                    id: channel_grid
                                    cols: 1
                                    size_hint_y: None
                                    height: self.minimum_height
                                    spacing: dp(2)
                                    padding: [dp(6), dp(6)]
            # right: members drawer (swipe from the right edge opens)
            BoxLayout:
                id: right_sidebar
                size_hint: None, 1
                # Polish group 3: see left_sidebar (MainScreen.right_width).
                width: root.right_width
                orientation: 'vertical'
                pos_hint: {'right': 1}
                canvas.before:
                    Color:
                        rgba: app.theme_colors['bg_sidebar']
                    Rectangle:
                        pos: self.pos
                        size: self.size
                StencilView:
                    id: right_clip
                    size_hint: 1, 1
                    BoxLayout:
                        id: right_pane
                        orientation: 'vertical'
                        pos: self.parent.pos
                        size: self.parent.size
                        Label:
                            text: 'PEOPLE'
                            color: app.theme_colors['text_dim']
                            bold: True
                            font_size: sp(11)
                            size_hint_y: None
                            height: dp(48)
                            halign: 'left'
                            valign: 'middle'
                            text_size: max(0, self.width - dp(24)), self.height
                        ScrollView:
                            do_scroll_x: False
                            GridLayout:
                                id: member_grid
                                cols: 1
                                size_hint_y: None
                                height: self.minimum_height
                                spacing: dp(2)
                                padding: [dp(6), dp(6)]
<OnboardingScreen>:
    FloatLayout:
        canvas.before:
            Color:
                rgba: app.theme_colors['bg_main']
            Rectangle:
                pos: self.pos
                size: self.size
        AuroraBackground:
            size_hint: 1, 1
            colors: [app.theme_colors['aurora_a'], app.theme_colors['aurora_b'], app.theme_colors['aurora_c']]
        BoxLayout:
            id: intro_card
            orientation: 'vertical'
            size_hint: None, None
            width: min(dp(420), root.width - dp(32))
            height: min((dp(700) if root.stage == 2 else dp(560)), root.height - dp(32))
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
            padding: [dp(24), dp(28)]
            spacing: dp(16)
            canvas.before:
                Color:
                    rgba: app.theme_colors['panel']
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(24), dp(24), dp(24), dp(24)]
            ScrollView:
                do_scroll_x: False
                bar_width: dp(6)
                size_hint_y: 1
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(16)
                    Image:
                        source: app.banner_config_path or ''
                        size_hint_y: None
                        height: dp(122) if app.banner_config_path else 0
                        opacity: 1 if app.banner_config_path else 0
                        allow_stretch: False
                        keep_ratio: True
                    Label:
                        text: '0%d  /  03' % (root.stage + 1)
                        color: app.theme_colors['accent']
                        font_size: sp(12)
                        size_hint_y: None
                        height: dp(24)
                    Label:
                        text: root.titles[root.stage]
                        font_name: 'MeshDisplay'
                        color: app.theme_colors['text']
                        bold: True
                        font_size: sp(28)
                        size_hint_y: None
                        height: dp(48)
                    Label:
                        text: root.descriptions[root.stage]
                        color: app.theme_colors['text_muted']
                        font_size: sp(15)
                        text_size: self.width, None
                        halign: 'center'
                        valign: 'middle'
                        size_hint_y: None
                        height: self.texture_size[1]
                    BoxLayout:
                        spacing: dp(10)
                        size_hint_y: None
                        height: dp(52) if root.stage == 2 else 0
                        opacity: 1 if root.stage == 2 else 0
                        PfpImage:
                            size_hint_x: None
                            width: dp(44)
                            source: app.avatar_preview or ""
                            fallback_letter: (app.onboarding_name or '')[:1]
                            allow_stretch: False
                            keep_ratio: True
                        FancyMDButton:
                            variant: 'outlined'
                            size_hint_x: None
                            width: dp(160)
                            height: dp(40)
                            on_press: app.open_file_chooser(avatar=True)
                            MDButtonText:
                                text: 'Choose photo'
                                text_color: app.theme_colors['text']
                    MDTextField:
                        id: welcome_name
                        text: app.onboarding_name
                        mode: 'filled'
                        multiline: False
                        size_hint_y: None
                        height: dp(44) if root.stage == 2 else 0
                        opacity: 1 if root.stage == 2 else 0
                        fill_color_normal: app.theme_colors['input_bg']
                        text_color_normal: app.theme_colors['text']
                        MDTextFieldHintText:
                            text: 'Your name on the mesh'
                    MDTextField:
                        id: onb_hub
                        mode: 'filled'
                        multiline: False
                        size_hint_y: None
                        height: dp(44) if root.stage == 2 else 0
                        opacity: 1 if root.stage == 2 else 0
                        fill_color_normal: app.theme_colors['input_bg']
                        text_color_normal: app.theme_colors['text']
                        MDTextFieldHintText:
                            text: 'Hub address (ip:port), empty = community hub'
                    MDTextField:
                        id: onb_node
                        mode: 'filled'
                        multiline: False
                        size_hint_y: None
                        height: dp(44) if root.stage == 2 else 0
                        opacity: 1 if root.stage == 2 else 0
                        fill_color_normal: app.theme_colors['input_bg']
                        text_color_normal: app.theme_colors['text']
                        MDTextFieldHintText:
                            text: 'Guild node hash (optional)'
                    BoxLayout:
                        spacing: dp(10)
                        size_hint_y: None
                        height: dp(44) if root.stage == 2 else 0
                        opacity: 1 if root.stage == 2 else 0
                        MDTextField:
                            id: onb_delivery
                            # G6: explicit 44px like its siblings -- without it
                            # the filled field floors itself at dp(56) and sticks
                            # 12px out of its 44px row.
                            size_hint_y: None
                            height: dp(44)
                            mode: 'filled'
                            multiline: False
                            fill_color_normal: app.theme_colors['input_bg']
                            text_color_normal: app.theme_colors['text']
                            MDTextFieldHintText:
                                text: 'Delivery hash (optional)'
            FancyMDButton:
                variant: 'primary'
                size_hint_y: None
                height: dp(46)
                on_press: root.advance()
                MDButtonText:
                    disabled: root.stage == 2 and not welcome_name.text.strip()
                    text: 'Protect identity' if root.stage == 2 else 'Continue'
                    text_color: app.theme_colors['btn_text']
            FancyMDButton:
                variant: 'outlined'
                size_hint_y: None
                height: dp(44) if root.stage == 0 else 0
                opacity: 1 if root.stage == 0 else 0
                disabled: root.stage != 0
                on_press: app.open_restore_sheet()
                MDButtonText:
                    text: 'Restore an identity'
                    text_color: app.theme_colors['text']

<ConnectScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: app.theme_colors['bg_main']
            Rectangle:
                pos: self.pos
                size: self.size
        ScrollView:
            do_scroll_x: False
            bar_width: dp(6)
            size_hint_y: 1
            GridLayout:
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(24), dp(24), dp(24), dp(12)]
                spacing: dp(12)
                # The banner is decorative and must never push the Connect
                # button off-screen: it used to be dp(200) tall, which with
                # the rest of the form needed 820px and clipped the top 42px
                # of the image at a 738px window height (180px at 600px).
                Image:
                    id: banner_config
                    source: app.banner_config_path or ''
                    size_hint_y: None
                    height: dp(96) if app.banner_config_path else 0
                    opacity: 1 if app.banner_config_path else 0
                    size_hint_x: None
                    width: dp(240)
                    pos_hint: {'center_x': 0.5}
                    allow_stretch: False
                    keep_ratio: True
                Label:
                    text: 'sHades'
                    font_size: sp(40)
                    bold: True
                    color: app.theme_colors['text']
                    size_hint_y: None
                    height: dp(56)
                    halign: 'center'
                    text_size: self.width, None
                Label:
                    text: 'A quieter place to gather, beyond the grid.'
                    color: app.theme_colors['text_muted']
                    size_hint_y: None
                    height: dp(24)
                    halign: 'center'
                    text_size: self.width, None
                # Fixed-width form centred with spacers: a 44px field
                # stretched across the whole window (1286px) is unusable.
                Widget:
                    size_hint_y: None
                    height: dp(4)
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(206)
                    Widget:
                        size_hint_x: 1
                    BoxLayout:
                        orientation: 'vertical'
                        spacing: dp(10)
                        size_hint_x: None
                        width: min(dp(420), root.width - dp(48))
                        MDTextField:
                            id: hub_address
                            multiline: False
                            size_hint_y: None
                            height: dp(44)
                            # G5 (UIX P2-4): border tokens -- the filled
                            # field otherwise has no visible boundary.
                            # theme_line_color must be 'Custom' or the
                            # line colors below are ignored (KivyMD 2.0
                            # defaults them to the theme's Primary).
                            theme_line_color: 'Custom'
                            line_color_normal: app.theme_colors['border_subtle']
                            line_color_focus: app.theme_colors['border']
                            fill_color_normal: app.theme_colors['input_bg']
                            fill_color_focus: app.theme_colors['input_bg_focus']
                            text_color_normal: app.theme_colors['text']
                            text_color_focus: app.theme_colors['text']
                            cursor_color: app.theme_colors['text']
                            MDTextFieldHintText:
                                text: 'Hub address (ip:port)'
                                text_color_normal: app.theme_colors['text']
                                text_color_focus: app.theme_colors['text']
                        MDTextField:
                            id: username
                            text: app.username
                            multiline: False
                            size_hint_y: None
                            height: dp(44)
                            # G5 (UIX P2-4): border tokens (see hub_address).
                            theme_line_color: 'Custom'
                            line_color_normal: app.theme_colors['border_subtle']
                            line_color_focus: app.theme_colors['border']
                            fill_color_normal: app.theme_colors['input_bg']
                            fill_color_focus: app.theme_colors['input_bg_focus']
                            text_color_normal: app.theme_colors['text']
                            text_color_focus: app.theme_colors['text']
                            cursor_color: app.theme_colors['text']
                            MDTextFieldHintText:
                                text: 'Your username'
                                text_color_normal: app.theme_colors['text']
                                text_color_focus: app.theme_colors['text']
                        # The guild hashes are optional -- auto-discovery from
                        # the hub's announce covers them -- so they are behind
                        # a disclosure instead of four more always-visible
                        # fields with four helper labels underneath.
                        FancyMDButton:
                            id: advanced_toggle
                            variant: 'outlined'
                            size_hint_x: None
                            width: self.parent.width
                            size_hint_y: None
                            height: scaled(dp(40))
                            on_press: root.toggle_advanced()
                            MDButtonText:
                                id: advanced_label
                                text: 'Advanced: guild hashes'
                        FancyMDButton:
                            variant: 'primary'
                            size_hint_x: None
                            width: self.parent.width
                            size_hint_y: None
                            height: scaled(dp(40))
                            disabled: app.connect_username_required and not username.text
                            on_press: app.connect_to_guild(hub_address.text, username.text, node_hash.text, delivery_hash.text)
                            MDButtonText:
                                text: 'Connect'
                                text_color: app.theme_colors['btn_text']
                    Widget:
                        size_hint_x: 1
                # Optional hash fields, collapsed by default. They live in
                # their own block so the disclosure can toggle its height,
                # and share the same 420px centred measure as the main form
                # so they do not stretch across the whole window.
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: 0
                    id: advanced_box
                    opacity: 0
                    # Height is driven from Python (toggle_advanced):
                    # 0 when collapsed, minimum_height when open.
                    Widget:
                        size_hint_x: 1
                    BoxLayout:
                        orientation: 'vertical'
                        spacing: dp(10)
                        size_hint_x: None
                        width: min(dp(420), root.width - dp(48))
                        size_hint_y: None
                        height: self.minimum_height
                        MDTextField:
                            id: node_hash
                            multiline: False
                            size_hint_y: None
                            height: dp(44)
                            # G5 (UIX P2-4): border tokens (see hub_address).
                            theme_line_color: 'Custom'
                            line_color_normal: app.theme_colors['border_subtle']
                            line_color_focus: app.theme_colors['border']
                            fill_color_normal: app.theme_colors['input_bg']
                            fill_color_focus: app.theme_colors['input_bg_focus']
                            text_color_normal: app.theme_colors['text']
                            text_color_focus: app.theme_colors['text']
                            cursor_color: app.theme_colors['text']
                            MDTextFieldHintText:
                                text: 'Guild node_hash (32 hex, optional)'
                        MDTextField:
                            id: delivery_hash
                            multiline: False
                            size_hint_y: None
                            height: dp(44)
                            # G5 (UIX P2-4): border tokens (see hub_address).
                            theme_line_color: 'Custom'
                            line_color_normal: app.theme_colors['border_subtle']
                            line_color_focus: app.theme_colors['border']
                            fill_color_normal: app.theme_colors['input_bg']
                            fill_color_focus: app.theme_colors['input_bg_focus']
                            text_color_normal: app.theme_colors['text']
                            text_color_focus: app.theme_colors['text']
                            cursor_color: app.theme_colors['text']
                            MDTextFieldHintText:
                                text: 'Guild delivery_hash (32 hex, optional)'
                    Widget:
                        size_hint_x: 1
        # The status line is OUTSIDE the scroll so a long message never
        # scrolls the Connect button out of reach.
        Label:
            id: status
            text: ''
            color: app.theme_colors['accent']
            font_size: sp(13)
            size_hint_y: None
            height: dp(30)
            halign: 'center'
            text_size: self.width, None

<SlimButton@Button>:
    size_hint_x: None
    # 14px was the whole touch target. The bar is drawn 14px wide but
    # the button is 48px so it can actually be hit.
    width: dp(48)
    size_hint_y: 1
    background_color: 0, 0, 0, 0
    color: app.theme_colors['text_muted']
    font_size: sp(17)
    bold: True
    canvas.before:
        Color:
            rgba: app.theme_colors['bg_sidebar']
        Rectangle:
            pos: self.pos
            size: self.size

<ConfigScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: app.theme_colors['bg_main']
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: 'Profile config'
            font_size: sp(24)
            bold: True
            color: app.theme_colors['text']
            size_hint_y: None
            height: dp(44)
        BoxLayout:
            size_hint_y: None
            height: dp(56)
            spacing: dp(8)
            padding: dp(6)
            FancyMDButton:
                id: tab_general
                size_hint_y: None
                height: dp(44)
                variant: 'primary'
                on_press: root.switch_tab('general')
                MDButtonText:
                    text: 'Appearance'
                    text_color: app.theme_colors['btn_text']
            FancyMDButton:
                id: tab_voice
                size_hint_y: None
                height: dp(44)
                variant: 'outlined'
                on_press: root.switch_tab('voice')
                MDButtonText:
                    text: 'Voice'
                    text_color: app.theme_colors['text']
        ScrollView:
            do_scroll_x: False
            BoxLayout:
                id: config_host
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                BoxLayout:
                    id: config_pages
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(12)
                    spacing: dp(8)
                    Label:
                        text: 'Theme presets'
                        font_size: sp(16)
                        bold: True
                        color: app.theme_colors['text_muted']
                        size_hint_y: None
                        height: dp(28)
                    GridLayout:
                        cols: 3
                        size_hint_y: None
                        height: dp(96)
                        spacing: dp(6)
                        FancyMDButton:
                            variant: 'outlined'
                            on_press: root.choose_preset('Midnight')
                            MDButtonText:
                                text: 'Midnight'
                        FancyMDButton:
                            variant: 'outlined'
                            on_press: root.choose_preset('Ember')
                            MDButtonText:
                                text: 'Ember'
                        FancyMDButton:
                            variant: 'outlined'
                            on_press: root.choose_preset('Mint')
                            MDButtonText:
                                text: 'Mint'
                        FancyMDButton:
                            variant: 'outlined'
                            on_press: root.choose_preset('Mono')
                            MDButtonText:
                                text: 'Mono'
                        FancyMDButton:
                            variant: 'outlined'
                            on_press: root.choose_preset('Daylight')
                            MDButtonText:
                                text: 'Daylight'
                    Label:
                        text: 'Fine tune colors (hex #RRGGBB)'
                        font_size: sp(16)
                        bold: True
                        color: app.theme_colors['text_muted']
                        size_hint_y: None
                        height: dp(28)
                    # One row per THEME_KEYS entry, generated in Python by
                    # ConfigScreen._ensure_color_rows. The previous 14
                    # hand-written KV blocks covered only 14 of the 17 keys --
                    # btn_text, border and border_subtle had no field and were
                    # silently skipped on save.
                    GridLayout:
                        id: theme_rows
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(8)
        Label:
            id: config_status
            text: ''
            color: app.theme_colors['accent']
            size_hint_y: None
            height: dp(26)
        BoxLayout:
            id: config_footer
            size_hint_y: None
            height: dp(56)
            padding: dp(12)
            spacing: dp(10)
            FancyMDButton:
                variant: 'primary'
                on_press: root.save_config()
                MDButtonText:
                    text: 'Save'
                    text_color: app.theme_colors['btn_text']
            FancyMDButton:
                variant: 'outlined'
                on_press: root.reset_config()
                MDButtonText:
                    text: 'Reset'
                    text_color: app.theme_colors['text']
            FancyMDButton:
                variant: 'outlined'
                on_press: app.root.current = 'main'
                MDButtonText:
                    text: 'Back'
                    text_color: app.theme_colors['text']
